# Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-recruitflow-ai-change-in-production

# Database Configuration (MySQL 8 for local/dev/prod)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=recruitflow_user
DB_PASSWORD=recruitflow_password
DB_NAME=recruitflow_db

# Optional direct connection URI override (if specified, overrides host/user/pass fields)
# DATABASE_URL=mysql+pymysql://recruitflow_user:recruitflow_password@127.0.0.1:3306/recruitflow_db

# Testing Database
TEST_DATABASE_URL=sqlite:///:memory:

# Security & Sessions
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Upload Configuration (Resume processing)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
